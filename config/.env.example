# Скопируйте в .env в корне проекта. Никаких реальных ключей в этом файле.

# Провайдер моделей (OpenAI-совместимый endpoint, адрес до /v1). Значения-образцы клиент
# не принимает: провайдер считается ненастроенным, зонд и smoke не запускаются.
PD_QWEN_BASE_URL=https://example.invalid/v1
PD_QWEN_API_KEY=replace-me

# Инференс VK (только для команд топ-10)
PD_VK_BASE_URL=
PD_VK_API_KEY=

# Valkey для очереди, лимитера и кэша
PD_VALKEY_URL=redis://valkey:6379/0

# Переопределения app.yaml (пример)
# PD_LIMITS__MAX_UPLOAD_MB=200
# PD_LLM__CACHE_MODE=replay        # off | read | read_write (data/llm-cache) | record | replay (tests/fixtures/llm)
# PD_LLM__CONCURRENCY=4            # умолчания лимитера, пока в config/models.yaml нет квот провайдера

# Режимы разработки
PD_ENV=development
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_BASE=/api

# Стек Docker Compose (на сервере эти строки пишет deploy/install.sh в $SERVER_DIR/.env)
# ONLYOFFICE обязателен для реального рендера. make up создаёт секрет автоматически.
# Для ручного запуска: openssl rand -hex 32 → PD_ONLYOFFICE__JWT_SECRET в приватном .env.
PD_ONLYOFFICE__JWT_SECRET=
# PD_ONLYOFFICE__PUBLIC_URL=http://localhost:8080/onlyoffice
# PD_GENERATION_WORKERS=3      # реплики воркеров генерации
# PD_RENDER_SLOTS=2            # одновременных конвертаций ONLYOFFICE (по замерам: не больше двух на 3,9 ГБ)
# PD_WORKER_MEMORY=1536M       # предел памяти контейнера воркера (docker/compose.prod.yaml)
# PD_API_MEMORY=512M           # предел памяти контейнера API

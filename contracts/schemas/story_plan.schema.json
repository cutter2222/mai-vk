{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentation-designer.local/contracts/story_plan.schema.json",
  "title": "StoryPlan",
  "description": "Общий смысловой план презентации, создаётся один раз из ContentPackage и не зависит от шаблона и геометрии. Три SlidePlan ссылаются на него и обязаны покрыть все обязательные тезисы. Версия 1.2 (этап 6): effective_brief — бриф и явные настройки запроса, применённые до построения плана (язык, аудитория, цель, обязательные тезисы, ограничения, число слайдов); coverage — покрытие обязательных фактов и пунктов брифа тезисами; content_hash считается по нормализованному содержанию пакета, effective_brief, модели, промпту и схеме, без идентификаторов заданий и времени.",
  "type": "object",
  "required": [
    "schema_version",
    "story_id",
    "package_id",
    "content_hash",
    "language",
    "purpose",
    "key_takeaway",
    "theses",
    "generation_meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "package_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "content_hash": {
      "type": "string",
      "description": "sha256 нормализованного содержания ContentPackage вместе с effective_brief, моделью, версией скилла/промпта и схемой ответа; ключ кэша StoryPlan. Не зависит от package_id, job_id и времени"
    },
    "language": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "feature",
        "product",
        "project",
        "initiative",
        "report",
        "other"
      ]
    },
    "audience": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "effective_brief": {
      "type": "object",
      "description": "бриф и явные настройки запроса, применённые до построения плана; смена любого поля меняет content_hash",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "feature",
            "product",
            "project",
            "initiative",
            "report",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "must_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slide_count": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exact": {
              "type": "integer",
              "minimum": 1
            },
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "key_takeaway": {
      "type": "string",
      "description": "главный вывод всей презентации одним предложением"
    },
    "theses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/thesis"
      }
    },
    "allowed_reductions": {
      "type": "array",
      "description": "что допустимо сокращать в компактных вариантах без потери обязательного содержания",
      "items": {
        "type": "object",
        "required": [
          "thesis_id",
          "reduction"
        ],
        "additionalProperties": false,
        "properties": {
          "thesis_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "reduction": {
            "enum": [
              "drop_examples",
              "merge_with",
              "shorten_wording",
              "table_to_chart",
              "chart_to_number",
              "drop_entirely"
            ]
          },
          "target_thesis_id": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "для merge_with: с каким тезисом объединить"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "description": "допущения режима брифа, отделённые от подтверждённых данных",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "description": "покрытие обязательного содержания тезисами: проверяется кодом до вёрстки",
      "additionalProperties": false,
      "properties": {
        "must_keep_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "covered"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "covered": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "must_include": {
          "type": "array",
          "description": "пункты brief.must_include и тезисы, которые их раскрывают; пустой список тезисов — пункт не покрыт",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "thesis_ids"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "thesis_ids": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "generation_meta": {
      "$ref": "common.schema.json#/$defs/generation_meta"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "$defs": {
    "thesis": {
      "type": "object",
      "required": [
        "thesis_id",
        "order",
        "kind",
        "statement",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "thesis_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "section",
            "claim",
            "evidence",
            "conclusion",
            "call_to_action",
            "context"
          ]
        },
        "parent_id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "тезис-раздел, к которому относится"
        },
        "statement": {
          "type": "string",
          "description": "формулировка-вывод; может содержать {fact:<fact_id>}"
        },
        "explanation": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "description": "обязателен во всех трёх вариантах"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "block_id из ContentPackage"
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "dataset_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "suggested_visual": {
          "enum": [
            "text",
            "bullets",
            "number",
            "chart",
            "table",
            "diagram",
            "image",
            "quote",
            "comparison",
            "timeline"
          ]
        }
      }
    }
  }
}

# Secrets and machine-specific environment settings.
.env
.env.*
!.env.example
!.env.*.example
/deploy/server.env
.envrc
.npmrc
/.secrets/
/secrets/
/credentials/

# Python environments, caches and build output.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# JavaScript dependencies and generated output. Keep dependency lockfiles.
node_modules/
.next/
.nuxt/
.vite/
.turbo/
.npm/
.pnpm-store/
dist/
build/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Local inputs and generated presentations, previews, metrics and model traces.
# Keep public, redistributable examples under examples/ or tests/fixtures/.
/data/
/artifacts/
/runs/
/backups/
/logs/
/tmp/
.cache/
*.log
~$*

# Local editor, OS and development-worktree files.
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
/.worktrees/

# Материалы организаторов: ТЗ, датасет и шаблоны. В открытый репозиторий не попадают.
/docs/Датасет/
/docs/*.pdf
/docs/*.pptx

# Документы планирования команды. В открытый репозиторий не попадают.
/PROJECT_BRIEF.md
/WORK_PLAN.md
/FRAMEWORKS.md
/docs/QUESTIONS_TO_ORGANIZERS.md
/IMPLEMENTATION_PLAN.md

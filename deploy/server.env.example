# Параметры сервера для скриптов deploy/. Скопируйте в deploy/server.env и заполните.
# Файл deploy/server.env в Git не попадает (.gitignore); адреса и доступы живут только здесь.

# SSH-адрес: пользователь@хост или алиас из ~/.ssh/config. Вход по ключу без пароля,
# пользователь root либо с sudo без пароля (install.sh ставит Docker).
SERVER_SSH=root@203.0.113.10

# Корень сервиса на сервере. install.sh создаёт repo, data, artifacts, runs, backups и .env.
SERVER_DIR=/srv/presentation-designer

# Объявленный адрес: только https. Свой домен с A-записью на сервер
# или имя вида https://203-0-113-10.sslip.io (точки IP заменены дефисами) — сертификат Caddy получит сам.
SERVER_URL=https://presentations.example.com

# Необязательно: запасные адреса через запятую, которые Caddy обслуживает вместе с основным
# (например, имя по IP на время переезда домена). Тоже только https.
SERVER_ALIAS_URLS=

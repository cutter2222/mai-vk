# Внешний вход стека: TLS и маршрутизация. Адрес берётся из .env сервера (PD_SITE_ADDRESS),
# в образы он не зашит. Для https://… Caddy сам получает и продлевает сертификат;
# для http://localhost работает без TLS, браузер считает localhost защищённым контекстом.

{
	servers {
		# Только TCP: HTTP/3 (QUIC по UDP) выключен — за VPN и на потерях UDP запросы браузера
		# зависали на секунды при свободном сервере (проверка этапа 3), h2 хватает.
		protocols h1 h2
		# Согласовано с API: загрузка до 100 МБ на медленном канале, ответы API быстрые,
		# длинные операции идут через задания и опрос состояния.
		timeouts {
			read_header 30s
			read_body 10m
			idle 5m
		}
	}
}

{$PD_SITE_ADDRESS} {
	# Один канонический адрес: имена с www. (если перечислены в PD_SITE_ADDRESS) ведут на PD_PUBLIC_URL.
	@www header_regexp Host ^www\.
	redir @www {$PD_PUBLIC_URL}{uri} permanent

	encode zstd gzip

	# Согласовано с limits.max_upload_mb в config/app.yaml: несколько файлов в одном запросе
	# помещаются в этот предел, точные квоты проверяет API.
	request_body {
		max_size 256MB
	}

	# API того же origin: интерфейс обращается по относительному пути /api.
	# Внутренние сервисы (api, valkey, frontend) наружу не публикуются; Valkey, база и хранилище
	# доступны только контейнерам стека.
	handle /api/* {
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				# Заголовки ответа приходят после приёма всего тела: загрузка файла может идти минуты.
				response_header_timeout 10m
			}
		}
	}

	handle {
		reverse_proxy frontend:8080
	}
}
